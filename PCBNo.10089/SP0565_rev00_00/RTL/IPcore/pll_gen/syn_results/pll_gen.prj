#-- Written on Sat Feb 22 16:53:14 2025


#device options
set_option -technology ecp5u
set_option -part LFE5U-25F
set_option -speed_grade 6

#use verilog 2001 standard option
set_option -vlog_std v2001

#map options
set_option -frequency 100
set_option -fanout_limit 50
set_option -disable_io_insertion true
set_option -retiming false
set_option -pipe false
set_option -pipe false
set_option -force_gsr false

#simulation options
set_option -write_verilog true
set_option -write_vhdl true

#timing analysis options

#automatic place and route (vendor) options
set_option -write_apr_constraint 1

#-- add_file options
add_file -vhdl -lib work "C:/work/Diamond/zz_customer/VHDL/Sysmex/05_20250221/PCBNo.10082_20250221/RTL/IPcore/pll_gen/pll_gen.vhd"
add_file -constraint {"C:/work/Diamond/zz_customer/VHDL/Sysmex/05_20250221/PCBNo.10082_20250221/RTL/IPcore/pll_gen/pll_gen.fdc"}

#-- top module name
set_option -top_module pll_gen

#-- set result format/file last
project -result_file "pll_gen.edn"

#-- error message log file
project -log_file pll_gen.srf

#-- run Synplify with 'arrange VHDL file'
project -run
