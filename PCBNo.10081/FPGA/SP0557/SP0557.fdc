#----------------------------------------------------------------------
# SP0557 Synplify Forward Declaration Constraint (FDC) File
# Purpose: Define PLL clock constraints and cross-domain timing constraints.
#
# Clock definitions moved here from pll_gen.fdc because Diamond 3.14
# Synplify cannot resolve {n:CLKOP_t} style net references within the
# EHXPLLL black box. Using full hierarchical net names from top level.
#
# PLL Configuration (EHXPLLL):
#   Input:  CLKI  = 20MHz (UP_CLK external)
#   VCO:    20MHz x 5 = 100MHz, CLKFB_DIV=5, CLKI_DIV=1
#   CLKOP:  100MHz, 0 deg   (CLKOP_DIV=6)  -> CLKCOM_OUT
#   CLKOS:  100MHz, 90 deg  (CLKOS_DIV=6)  -> CLK2A
#   CLKOS2: 20MHz,  0 deg   (CLKOS2_DIV=30) -> s_PLL_CLK20M
#   CLKOS3: 10MHz,  0 deg   (CLKOS3_DIV=60) -> CLK1
#
# Clock Name Reference:
#   CLKOP_100M    : 100MHz, 0 deg   (CLK2  - serial comm)
#   CLKOS_100M_90 : 100MHz, 90 deg  (CLK2A - CDR sampling)
#   CLKOS2_20M    : 20MHz,  0 deg   (s_PLL_CLK20M - system)
#   CLKOS3_10M    : 10MHz,  0 deg   (CLK1  - slave control)
#
# Date   : 2026-02-28
# Target : LFE5U-25F-6 CABGA256
#----------------------------------------------------------------------

#----------------------------------------------------------------------
# Section 0: PLL Output Clock Definitions
#
#   All PLL outputs MUST be in the SAME clock group to enable
#   Synplify timing analysis on cross-domain paths (especially
#   CLK2 <-> CLK2A in cds.vhd CDR module).
#
#   Net names from MT420 messages in Synplify V-2023.09L-2:
#     CLKOP  -> slv_com_top_inst.clk_gen_inst2.PLL_inst.CLKCOM_OUT
#     CLKOS  -> slv_com_top_inst.clk_gen_inst2.PLL_inst.CLK2A
#     CLKOS2 -> slv_com_top_inst.clk_gen_inst2.PLL_inst.s_PLL_CLK20M
#     CLKOS3 -> slv_com_top_inst.clk_gen_inst2.PLL_inst.CLK1
#----------------------------------------------------------------------

# CLKOP: 100MHz serial communication clock (0 deg phase)
# Used by: cds.vhd (domain A,C), rx_ctl_1st, tx_com, dcfifo_rx/tx
define_clock -name {CLKOP_100M} \
    {n:slv_com_top_inst.clk_gen_inst2.PLL_inst.CLKCOM_OUT} \
    -freq 100.000 \
    -rise 0.000 -fall 5.000 \
    -clockgroup pll_clks

# CLKOS: 100MHz CDR sampling clock (90 deg phase = 2.5ns offset)
# Used by: cds.vhd (domain B,D), rst_cnt
# CRITICAL: -rise 2.500 communicates the 90-degree phase shift to
# Synplify, enabling correct setup/hold analysis for cds.vhd
# mesochronous CDC paths (bz, cz, dz signal crossings).
define_clock -name {CLKOS_100M_90} \
    {n:slv_com_top_inst.clk_gen_inst2.PLL_inst.CLK2A} \
    -freq 100.000 \
    -rise 2.500 -fall 7.500 \
    -clockgroup pll_clks

# CLKOS2: 20MHz system clock (0 deg phase)
# Used by: GPIO, encoder, ADC, DAC, motor control, sp_conv
define_clock -name {CLKOS2_20M} \
    {n:slv_com_top_inst.clk_gen_inst2.PLL_inst.s_PLL_CLK20M} \
    -freq 20.000 \
    -rise 0.000 -fall 25.000 \
    -clockgroup pll_clks

# CLKOS3: 10MHz slave control clock (0 deg phase)
# Used by: slv_ctrl, 8b10b enc/dec, rx/tx control state machines
define_clock -name {CLKOS3_10M} \
    {n:slv_com_top_inst.clk_gen_inst2.PLL_inst.CLK1} \
    -freq 10.000 \
    -rise 0.000 -fall 50.000 \
    -clockgroup pll_clks

#----------------------------------------------------------------------
# Section 1: External Clock Domain Isolation
#
#   CLK20M (external 20MHz input, p:CLK20M) feeds CLKSLV in slv_com_top.
#   It drives only rst_cnt LOCAL_CLK counter and ck_state FSM.
#   No direct functional data transfer between CLK20M domain and
#   PLL output domains. All are physically isolated.
#----------------------------------------------------------------------
define_clock -name {CLK20M_ext} \
    {p:CLK20M} \
    -freq 20.000 \
    -rise 0.000 -fall 25.000 \
    -clockgroup ext_clks

define_false_path -from {CLK20M_ext} -to {CLKOP_100M}
define_false_path -from {CLK20M_ext} -to {CLKOS_100M_90}
define_false_path -from {CLK20M_ext} -to {CLKOS2_20M}
define_false_path -from {CLK20M_ext} -to {CLKOS3_10M}
define_false_path -from {CLKOP_100M}    -to {CLK20M_ext}
define_false_path -from {CLKOS_100M_90} -to {CLK20M_ext}
define_false_path -from {CLKOS2_20M}    -to {CLK20M_ext}
define_false_path -from {CLKOS3_10M}    -to {CLK20M_ext}

#----------------------------------------------------------------------
# Section 2: CLKOS2 (20MHz) <-> CLKOS3 (10MHz) Multicycle
#
#   Same PLL, 2:1 frequency ratio.
#   Data from 20MHz is stable for 2 CLKOS3 periods before capture.
#   ~2,478 paths between these domains.
#----------------------------------------------------------------------
define_multicycle_path -from {CLKOS2_20M} -to {CLKOS3_10M} 2
define_multicycle_path -from {CLKOS3_10M} -to {CLKOS2_20M} 2

#----------------------------------------------------------------------
# Section 3: CLKOS3 (10MHz) <-> CLKOP (100MHz) Multicycle
#
#   Same PLL, 1:10 frequency ratio.
#   CLK1 -> CLK2: Data from 10MHz is stable for 10 CLK2 periods (100ns).
#   Targets: DCFIFO gray-pointer crossings in rx_cont_b1, tx_cont_b1.
#   CLK2 -> CLK1: Fast-to-slow. 2x relaxation for CDC sync chains.
#----------------------------------------------------------------------
define_multicycle_path -from {CLKOS3_10M} -to {CLKOP_100M} 10
define_multicycle_path -from {CLKOP_100M} -to {CLKOS3_10M} 2

#----------------------------------------------------------------------
# Section 4: CLKOS3 (10MHz) <-> CLKOS (100MHz, 90deg) Multicycle
#
#   Same as Section 3 but for CLK2A domain.
#   CLK1 <-> CLK2A paths: internal to slv_com_top (rst_cnt sync).
#----------------------------------------------------------------------
define_multicycle_path -from {CLKOS3_10M}    -to {CLKOS_100M_90} 10
define_multicycle_path -from {CLKOS_100M_90} -to {CLKOS3_10M} 2

#----------------------------------------------------------------------
# Section 5: CLKOS2 (20MHz) <-> CLKOP/CLKOS (100MHz) False Path
#
#   No direct data transfer between 20MHz system domain and 100MHz
#   communication domain. All CDC is through DCFIFO IP blocks.
#----------------------------------------------------------------------
define_false_path -from {CLKOS2_20M} -to {CLKOP_100M}
define_false_path -from {CLKOP_100M} -to {CLKOS2_20M}
define_false_path -from {CLKOS2_20M} -to {CLKOS_100M_90}
define_false_path -from {CLKOS_100M_90} -to {CLKOS2_20M}

#----------------------------------------------------------------------
# Section 6: CLKOP (100MHz, 0deg) <-> CLKOS (100MHz, 90deg)
#
#   SAME frequency, 90-degree phase offset. These are the CRITICAL
#   mesochronous CDC paths in cds.vhd (CDR module).
#   With both clocks in the same group "pll_clks" and the 90-degree
#   phase offset defined above, Synplify will analyze these paths
#   with the correct 2.5ns/7.5ns setup/hold windows.
#   NO multicycle needed - they are same frequency, just phase-shifted.
#----------------------------------------------------------------------

#----------------------------------------------------------------------
# Section 7: Register Preservation (syn_preserve)
#
#   Prevent Synplify from merging equivalent registers or optimizing
#   constant-driven registers to logic. Each register drives separate
#   hardware outputs or is required for interface compliance.
#
#   NOTE: Registers subject to CL190 (constant optimization) or CL177
#   (register sharing) at the COMPILER phase must use RTL-level
#   attributes, because FDC syn_preserve is applied at MAPPER phase
#   (too late). The following registers are now handled in RTL:
#     - s_LEDPTN (LEDLT_TOP.vhd)      -> RTL syn_preserve
#     - s_prpty (slv_ctrl_top.vhd)     -> RTL syn_preserve
#     - sp_dt/sp_dt_1q (rx_ctl_1st.vhd) -> RTL syn_preserve
#     - DATAOUT (dec6b_5b.vhd)         -> RTL syn_preserve
#----------------------------------------------------------------------

# 7A: EFUSE_CTRL - Power enable registers (BN132: equivalent register merging)
#     Each s_PW_*_EN drives a separate eFuse power switch on the PCB.
#     Merging would cause multiple power rails to share a single driver.
define_attribute {EFUSE_CTRL_inst.s_PW_SV_EN}      syn_preserve {1}
define_attribute {EFUSE_CTRL_inst.s_PW_PUMP_EN}    syn_preserve {1}
define_attribute {EFUSE_CTRL_inst.s_PW_PLS_EN}     syn_preserve {1}
define_attribute {EFUSE_CTRL_inst.s_PW_LMT_EN}     syn_preserve {1}
define_attribute {EFUSE_CTRL_inst.s_PW_ENC_EN}     syn_preserve {1}
define_attribute {EFUSE_CTRL_inst.s_PW_SNS_EN}     syn_preserve {1}
define_attribute {EFUSE_CTRL_inst.s_PW_SNSLED_EN}  syn_preserve {1}
define_attribute {EFUSE_CTRL_inst.s_PW_PLSSNS_EN}  syn_preserve {1}
define_attribute {EFUSE_CTRL_inst.s_PW_LEDSH_EN}   syn_preserve {1}
define_attribute {EFUSE_CTRL_inst.s_PW_LEDLT_EN}   syn_preserve {1}

# 7B: EFUSE_CTRL - MODE register (CL190: optimized to constant)
#     4-bit bus width matches interface specification.
define_attribute {EFUSE_CTRL_inst.s_MODE[3]}  syn_preserve {1}
define_attribute {EFUSE_CTRL_inst.s_MODE[2]}  syn_preserve {1}
define_attribute {EFUSE_CTRL_inst.s_MODE[1]}  syn_preserve {1}

# 7C: ppmc_top_S118M - Limit switch registers (BN132: equivalent merging)
#     Each stm instance's s_LCW/s_LCCW drives separate stepper motor limit.
define_attribute {stm01.s_LCW}  syn_preserve {1}
define_attribute {stm01.s_LCCW} syn_preserve {1}
define_attribute {stm02.s_LCW}  syn_preserve {1}
define_attribute {stm02.s_LCCW} syn_preserve {1}
define_attribute {stm03.s_LCW}  syn_preserve {1}
define_attribute {stm03.s_LCCW} syn_preserve {1}
define_attribute {stm04.s_LCW}  syn_preserve {1}
define_attribute {stm04.s_LCCW} syn_preserve {1}
define_attribute {stm05.s_LCW}  syn_preserve {1}
define_attribute {stm05.s_LCCW} syn_preserve {1}
define_attribute {stm06.s_LCW}  syn_preserve {1}
define_attribute {stm06.s_LCCW} syn_preserve {1}
define_attribute {stm07.s_LCW}  syn_preserve {1}
define_attribute {stm07.s_LCCW} syn_preserve {1}
define_attribute {stm08.s_LCW}  syn_preserve {1}
define_attribute {stm08.s_LCCW} syn_preserve {1}
define_attribute {stm09.s_LCW}  syn_preserve {1}
define_attribute {stm09.s_LCCW} syn_preserve {1}
define_attribute {stm10.s_LCW}  syn_preserve {1}
define_attribute {stm10.s_LCCW} syn_preserve {1}
define_attribute {stm11.s_LCW}  syn_preserve {1}
define_attribute {stm11.s_LCCW} syn_preserve {1}
define_attribute {stm12.s_LCW}  syn_preserve {1}
define_attribute {stm12.s_LCCW} syn_preserve {1}
define_attribute {stm13.s_LCW}  syn_preserve {1}
define_attribute {stm13.s_LCCW} syn_preserve {1}

# 7D: slv_rx_ctrl - NODE registers (BN132: equivalent to ADR2)
#     NODE and ADR2 are separate bus interfaces; must not be merged.
define_attribute {slv_com_top_inst.slv_ctrl_top_inst.slv_rx_ctrl_inst.NODE[0]} syn_preserve {1}
define_attribute {slv_com_top_inst.slv_ctrl_top_inst.slv_rx_ctrl_inst.NODE[1]} syn_preserve {1}
define_attribute {slv_com_top_inst.slv_ctrl_top_inst.slv_rx_ctrl_inst.NODE[2]} syn_preserve {1}
define_attribute {slv_com_top_inst.slv_ctrl_top_inst.slv_rx_ctrl_inst.NODE[3]} syn_preserve {1}

# 7F: CTRL_32CH - s_LATCH register (MO160: always 0)
#     32-bit latch bus; upper bits reserved for future DAC channel expansion.
define_attribute {v:work.CTRL_32CH} syn_preserve {1}

# 7G: ppmc_rgstr - MPI_A pipeline (MO129: constant propagation)
#     Motor position input pipeline; bit 0 may be constant in current config
#     but register is required for timing closure across all stepper channels.
define_attribute {stm01.ppmc_reg_S118M_inst.inst_ppmc_rgstr.MPI_A[0]}  syn_preserve {1}
define_attribute {stm02.ppmc_reg_S118M_inst.inst_ppmc_rgstr.MPI_A[0]}  syn_preserve {1}
define_attribute {stm03.ppmc_reg_S118M_inst.inst_ppmc_rgstr.MPI_A[0]}  syn_preserve {1}
define_attribute {stm04.ppmc_reg_S118M_inst.inst_ppmc_rgstr.MPI_A[0]}  syn_preserve {1}
define_attribute {stm05.ppmc_reg_S118M_inst.inst_ppmc_rgstr.MPI_A[0]}  syn_preserve {1}
define_attribute {stm06.ppmc_reg_S118M_inst.inst_ppmc_rgstr.MPI_A[0]}  syn_preserve {1}
define_attribute {stm07.ppmc_reg_S118M_inst.inst_ppmc_rgstr.MPI_A[0]}  syn_preserve {1}
define_attribute {stm08.ppmc_reg_S118M_inst.inst_ppmc_rgstr.MPI_A[0]}  syn_preserve {1}
define_attribute {stm09.ppmc_reg_S118M_inst.inst_ppmc_rgstr.MPI_A[0]}  syn_preserve {1}
define_attribute {stm10.ppmc_reg_S118M_inst.inst_ppmc_rgstr.MPI_A[0]}  syn_preserve {1}
define_attribute {stm11.ppmc_reg_S118M_inst.inst_ppmc_rgstr.MPI_A[0]}  syn_preserve {1}
define_attribute {stm12.ppmc_reg_S118M_inst.inst_ppmc_rgstr.MPI_A[0]}  syn_preserve {1}
define_attribute {stm13.ppmc_reg_S118M_inst.inst_ppmc_rgstr.MPI_A[0]}  syn_preserve {1}

# 7H: gpio_ip_reg - REG1 registers (MO129: constant propagation)
#     GPIO input registers; specific bits tied to constant in current board
#     config but register must be preserved for read-back functionality.
define_attribute {gpio01.gpio_reg_inst.gpio_ip_reg_inst31.REG1[5]} syn_preserve {1}
define_attribute {gpio01.gpio_reg_inst.gpio_ip_reg_inst3.REG1[2]}  syn_preserve {1}
define_attribute {gpio02.gpio_reg_inst.gpio_ip_reg_inst14.REG1[3]} syn_preserve {1}
define_attribute {gpio02.gpio_reg_inst.gpio_ip_reg_inst17.REG1[1]} syn_preserve {1}
define_attribute {gpio02.gpio_reg_inst.gpio_ip_reg_inst10.REG1[4]} syn_preserve {1}
define_attribute {gpio02.gpio_reg_inst.gpio_ip_reg_inst12.REG1[5]} syn_preserve {1}
define_attribute {gpio02.gpio_reg_inst.gpio_ip_reg_inst6.REG1[2]}  syn_preserve {1}
define_attribute {gpio02.gpio_reg_inst.gpio_ip_reg_inst8.REG1[4]}  syn_preserve {1}

# 7I: ppmc_rgstr - LIMIT_IN_A, LIMIT_MONITOR_REG_O (CL111/CL190)
#     Limit switch monitoring; unused bits are '0' by design but register
#     width matches S3IO protocol bus width.
define_attribute {v:work.ppmc_rgstr} syn_preserve {1}

# 7L: slv_rx_ctrl - byte_cnt (CL190: optimized to constant)
define_attribute {slv_com_top_inst.slv_ctrl_top_inst.slv_rx_ctrl_inst.byte_cnt[2]} syn_preserve {1}

# 7N: ppmc_ctrl - s_pls_ld / ENB_START (CL177: register sharing)
#     Separate control signals; must not be merged.
define_attribute {v:work.ppmc_ctrl} syn_preserve {1}

#----------------------------------------------------------------------
# Section 8: Combinational Loop Suppression (syn_loopcheck)
#
#   The encoder noise filter has a registered MUX with self-feedback:
#     s_ph_a_D = (s_ph_a == ENCPHASE_A) ? s_ph_a : ...
#   The MUX select depends on s_ph_a (register Q output), and one MUX
#   input is s_ph_a itself (hold path). This is a REGISTERED feedback
#   through a D flip-flop, NOT a true combinational loop.
#   The mapper (BN137/BN161) flags 4 MUX control nets per encoder instance
#   x 13 channels = 52 nets (reported ~100 times due to dual-pass mapping).
#----------------------------------------------------------------------
define_attribute {v:work.encoder_2bit} syn_loopcheck {0}
