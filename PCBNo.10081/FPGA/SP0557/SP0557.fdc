#----------------------------------------------------------------------
# SP0557 Synplify Constraint File (SDC + Synplify attribute commands)
# Purpose: PLL clock definitions and cross-domain timing constraints.
#
# Rev.4 (2026-03-01): All timing constraints converted to SDC format
#   to use create_clock + get_pins for EHXPLLL blackbox pins.
#   (FDC define_clock and SDC create_clock cannot coexist: MF720)
#
# Rev.4c (2026-03-01): Removed false_path/multicycle constraints for
#   domain pairs with no physical data paths to eliminate MT447/MT446.
#   Retained only constraints for paths that actually exist in design.
#
#   Previous attempts all failed with MT548:
#     Rev.1: FDC {n:...PLLInst_0.CLKOP}     (blackbox pin, not net)
#     Rev.2: FDC {n:...PLL_inst.CLKCOM_OUT}  ({n:} cannot resolve)
#     Rev.3: FDC {p:CLKOP} in pll_gen.fdc    (global FDC = top scope)
#
# Clock Names:
#   CLKOP_100M    : 100MHz, 0 deg   (CLKOP  -> CLKCOM_OUT -> serial comm)
#   CLKOS_100M_90 : 100MHz, 90 deg  (CLKOS  -> CLK2A -> CDR sampling)
#   CLKOS2_20M    : 20MHz,  0 deg   (CLKOS2 -> s_PLL_CLK20M -> system)
#   CLKOS3_10M    : 10MHz,  0 deg   (CLKOS3 -> CLK1 -> slave control)
#   CLK20M_ext    : 20MHz,  external input
#
# Target : LFE5U-25F-6 CABGA256
#----------------------------------------------------------------------

#----------------------------------------------------------------------
# Section 0: PLL Output Clock Definitions (SDC create_clock + get_pins)
#
#   Hierarchy: SP0557 -> slv_com_top_inst -> clk_gen_inst2 -> PLL_inst -> PLLInst_0
#----------------------------------------------------------------------
create_clock -name {CLKOP_100M} -period 10.000 -waveform {0.000 5.000} \
    [get_pins {slv_com_top_inst.clk_gen_inst2.PLL_inst.PLLInst_0.CLKOP}]

create_clock -name {CLKOS_100M_90} -period 10.000 -waveform {2.500 7.500} \
    [get_pins {slv_com_top_inst.clk_gen_inst2.PLL_inst.PLLInst_0.CLKOS}]

create_clock -name {CLKOS2_20M} -period 50.000 -waveform {0.000 25.000} \
    [get_pins {slv_com_top_inst.clk_gen_inst2.PLL_inst.PLLInst_0.CLKOS2}]

create_clock -name {CLKOS3_10M} -period 100.000 -waveform {0.000 50.000} \
    [get_pins {slv_com_top_inst.clk_gen_inst2.PLL_inst.PLLInst_0.CLKOS3}]

#----------------------------------------------------------------------
# Section 1: External Clock Definition and Domain Isolation
#
#   CLK20M (external 20MHz input) feeds only rst_cnt LOCAL_CLK counter
#   and ck_state FSM. Only CLKOS3_10M domain has actual data paths
#   to/from CLK20M domain (rst_cnt clock monitors).
#
#   Rev.4c: Removed false_path for domain pairs with no physical paths
#     (CLK20M_ext <-> CLKOP_100M, CLKOS_100M_90, CLKOS2_20M)
#     to eliminate MT447 warnings. Retained only paths that exist.
#----------------------------------------------------------------------
create_clock -name {CLK20M_ext} -period 50.000 -waveform {0.000 25.000} \
    [get_ports {CLK20M}]

set_false_path -from [get_clocks {CLK20M_ext}] -to [get_clocks {CLKOS3_10M}]
set_false_path -from [get_clocks {CLKOS3_10M}]    -to [get_clocks {CLK20M_ext}]

#----------------------------------------------------------------------
# Section 2: CLKOS2 (20MHz) <-> CLKOS3 (10MHz) Multicycle
#
#   Same PLL, 2:1 frequency ratio.
#   Data from 20MHz is stable for 2 CLKOS3 periods before capture.
#----------------------------------------------------------------------
set_multicycle_path 2 -from [get_clocks {CLKOS2_20M}] -to [get_clocks {CLKOS3_10M}]
set_multicycle_path 2 -from [get_clocks {CLKOS3_10M}] -to [get_clocks {CLKOS2_20M}]

#----------------------------------------------------------------------
# Section 3: CLKOS3 (10MHz) <-> CLKOP (100MHz) Multicycle
#
#   Same PLL, 1:10 frequency ratio.
#   CLK1 -> CLK2: Data from 10MHz is stable for 10 CLK2 periods.
#   CLK2 -> CLK1: Fast-to-slow. 2x relaxation for CDC sync chains.
#----------------------------------------------------------------------
set_multicycle_path 10 -from [get_clocks {CLKOS3_10M}] -to [get_clocks {CLKOP_100M}]
set_multicycle_path 2  -from [get_clocks {CLKOP_100M}] -to [get_clocks {CLKOS3_10M}]

#----------------------------------------------------------------------
# Section 4: (Removed in Rev.4c)
#
#   CLKOS3_10M <-> CLKOS_100M_90 multicycle was defined but no physical
#   data paths exist between these domains (MT446). Removed to eliminate
#   warning. If future RTL changes create paths, re-add constraints.
#----------------------------------------------------------------------

#----------------------------------------------------------------------
# Section 5: (Removed in Rev.4c)
#
#   CLKOS2_20M <-> CLKOP_100M/CLKOS_100M_90 false_path was defined but
#   no physical data paths exist between these domains (MT447).
#   CDC between 20MHz and 100MHz domains goes through DCFIFO IP blocks
#   which have their own internal synchronization (no cross-domain
#   register paths visible to Synplify). Removed to eliminate warning.
#----------------------------------------------------------------------

#----------------------------------------------------------------------
# Section 6: CLKOP (100MHz, 0deg) <-> CLKOS (100MHz, 90deg)
#
#   SAME frequency, 90-degree phase offset. Mesochronous CDC paths
#   in cds.vhd (CDR module). Synplify analyzes these with the correct
#   2.5ns/7.5ns setup/hold windows from the waveform definitions.
#   NO multicycle needed - same frequency, just phase-shifted.
#----------------------------------------------------------------------

#----------------------------------------------------------------------
# Section 7: View-level Register Preservation (syn_preserve)
#
#   All signal-level syn_preserve attributes are in the VHDL source.
#   View-level attributes below cover modules where output port
#   preservation is needed (Diamond 3.14 does not support
#   "attribute syn_preserve of PORT : signal" on output ports).
#
#   Module-specific VHDL source attributes:
#     EFUSE_CTRL.vhd    : s_PW_*_EN, s_MODE (BN132, CL190)
#     ppmc_top_S118M.vhd: s_LCW, s_LCCW (BN132)
#     ppmc_rgstr.vhd    : LIMIT_IN_A, LIMIT_MONITOR_REG_O, MPI_A (CL111, CL190)
#     gpio_ip_reg.vhd   : REG1 (MO129)
#     LEDLT_TOP.vhd     : s_LEDPTN (CL190)
#     slv_ctrl_top.vhd  : s_prpty (CL190)
#     slvadr_cnv.vhd    : s_HEX_OUT (CL279)
#     slv_rx_ctrl.vhd   : byte_cnt (CL190)
#     rx_ctl_1st.vhd    : sp_dt, sp_dt_1q, sp_dt_2q (CL177)
#----------------------------------------------------------------------

# 7A: CTRL_32CH - preserve s_LATCH register (upper bits reserved for future DAC expansion)
define_attribute {v:work.CTRL_32CH} syn_preserve {1}

# 7B: ppmc_rgstr - preserve all registers (LIMIT_IN_A, LIMIT_MONITOR_REG_O, MPI_A)
define_attribute {v:work.ppmc_rgstr} syn_preserve {1}

# 7C: ppmc_ctrl - preserve s_pls_ld / ENB_START separate control signals
define_attribute {v:work.ppmc_ctrl} syn_preserve {1}

# 7D: dec6b_5b - preserve DATAOUT register (output port, CD134 workaround)
define_attribute {v:work.dec6b_5b} syn_preserve {1}

# 7E: slv_rx_ctrl - preserve NODE register (output port, CD134 workaround)
define_attribute {v:work.slv_rx_ctrl} syn_preserve {1}

#----------------------------------------------------------------------
# Section 8: Combinational Loop Suppression (syn_loopcheck)
#
#   encoder_2bit has a registered MUX with self-feedback:
#     s_ph_a_D = (s_ph_a == ENCPHASE_A) ? s_ph_a : ...
#   This is a REGISTERED feedback through a D flip-flop, NOT a true
#   combinational loop. Suppresses BN161/BN137 for encoder instances.
#----------------------------------------------------------------------
define_attribute {v:work.encoder_2bit} syn_loopcheck {0}

#----------------------------------------------------------------------
# Section 9: IP Core Instance Preservation (syn_noprune)
#
#   Prevent removal of pll_gen internal utility instances (CL168).
#   scuba_vhi_inst (VHI) and scuba_vlo_inst (VLO) are generated by
#   Diamond IP generator and may appear unused after blackbox synthesis.
#----------------------------------------------------------------------
define_attribute {v:work.pll_gen} syn_noprune {1}
