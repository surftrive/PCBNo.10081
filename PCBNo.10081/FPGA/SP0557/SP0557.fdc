#----------------------------------------------------------------------
# SP0557 Synplify Forward Declaration Constraint (FDC) File
# Purpose: Define cross-domain timing constraints for PLL-derived clocks
#          and view-level synthesis attributes.
#
# Clock definitions use hierarchical net references {n:...} pointing to
# the EHXPLLL primitive output ports inside pll_gen. The path must
# reach PLLInst_0 (the EHXPLLL instance), NOT the pll_gen wrapper ports.
#
# Confirmed from SP0557_SP0557.srr inferred clock source paths:
#   pll_gen|CLKOP_inferred_clock  source: ...PLLInst_0.CLKOP(EHXPLLL)
#   pll_gen|CLKOS_inferred_clock  source: ...PLLInst_0.CLKOS(EHXPLLL)
#   pll_gen|CLKOS2_inferred_clock source: ...PLLInst_0.CLKOS2(EHXPLLL)
#   pll_gen|CLKOS3_inferred_clock source: ...PLLInst_0.CLKOS3(EHXPLLL)
#
# Clock Name Reference:
#   CLKOP_100M    : 100MHz, 0 deg   (CLKOP  -> CLKCOM_OUT -> serial comm)
#   CLKOS_100M_90 : 100MHz, 90 deg  (CLKOS  -> CLK2A -> CDR sampling)
#   CLKOS2_20M    : 20MHz,  0 deg   (CLKOS2 -> s_PLL_CLK20M -> system)
#   CLKOS3_10M    : 10MHz,  0 deg   (CLKOS3 -> CLK1 -> slave control)
#
# Date   : 2026-03-01
# Target : LFE5U-25F-6 CABGA256
#----------------------------------------------------------------------

#----------------------------------------------------------------------
# Section 0: PLL Output Clock Definitions (EHXPLLL primitive outputs)
#
#   Hierarchy: SP0557 -> slv_com_top_inst -> clk_gen_inst2 -> PLL_inst
#              -> PLLInst_0 (EHXPLLL primitive)
#----------------------------------------------------------------------
define_clock -name {CLKOP_100M} \
    {n:slv_com_top_inst.clk_gen_inst2.PLL_inst.PLLInst_0.CLKOP} \
    -freq 100.000 \
    -rise 0.000 -fall 5.000 \
    -clockgroup pll_clks

define_clock -name {CLKOS_100M_90} \
    {n:slv_com_top_inst.clk_gen_inst2.PLL_inst.PLLInst_0.CLKOS} \
    -freq 100.000 \
    -rise 2.500 -fall 7.500 \
    -clockgroup pll_clks

define_clock -name {CLKOS2_20M} \
    {n:slv_com_top_inst.clk_gen_inst2.PLL_inst.PLLInst_0.CLKOS2} \
    -freq 20.000 \
    -rise 0.000 -fall 25.000 \
    -clockgroup pll_clks

define_clock -name {CLKOS3_10M} \
    {n:slv_com_top_inst.clk_gen_inst2.PLL_inst.PLLInst_0.CLKOS3} \
    -freq 10.000 \
    -rise 0.000 -fall 50.000 \
    -clockgroup pll_clks

#----------------------------------------------------------------------
# Section 1: External Clock Domain Isolation
#
#   CLK20M (external 20MHz input) feeds only rst_cnt LOCAL_CLK counter
#   and ck_state FSM. No direct functional data transfer between
#   CLK20M domain and PLL output domains.
#----------------------------------------------------------------------
define_clock -name {CLK20M_ext} \
    {p:CLK20M} \
    -freq 20.000 \
    -rise 0.000 -fall 25.000 \
    -clockgroup ext_clks

define_false_path -from {CLK20M_ext} -to {CLKOP_100M}
define_false_path -from {CLK20M_ext} -to {CLKOS_100M_90}
define_false_path -from {CLK20M_ext} -to {CLKOS2_20M}
define_false_path -from {CLK20M_ext} -to {CLKOS3_10M}
define_false_path -from {CLKOP_100M}    -to {CLK20M_ext}
define_false_path -from {CLKOS_100M_90} -to {CLK20M_ext}
define_false_path -from {CLKOS2_20M}    -to {CLK20M_ext}
define_false_path -from {CLKOS3_10M}    -to {CLK20M_ext}

#----------------------------------------------------------------------
# Section 2: CLKOS2 (20MHz) <-> CLKOS3 (10MHz) Multicycle
#
#   Same PLL, 2:1 frequency ratio.
#   Data from 20MHz is stable for 2 CLKOS3 periods before capture.
#----------------------------------------------------------------------
define_multicycle_path -from {CLKOS2_20M} -to {CLKOS3_10M} 2
define_multicycle_path -from {CLKOS3_10M} -to {CLKOS2_20M} 2

#----------------------------------------------------------------------
# Section 3: CLKOS3 (10MHz) <-> CLKOP (100MHz) Multicycle
#
#   Same PLL, 1:10 frequency ratio.
#   CLK1 -> CLK2: Data from 10MHz is stable for 10 CLK2 periods.
#   CLK2 -> CLK1: Fast-to-slow. 2x relaxation for CDC sync chains.
#----------------------------------------------------------------------
define_multicycle_path -from {CLKOS3_10M} -to {CLKOP_100M} 10
define_multicycle_path -from {CLKOP_100M} -to {CLKOS3_10M} 2

#----------------------------------------------------------------------
# Section 4: CLKOS3 (10MHz) <-> CLKOS (100MHz, 90deg) Multicycle
#
#   Same as Section 3 but for CLK2A domain.
#----------------------------------------------------------------------
define_multicycle_path -from {CLKOS3_10M}    -to {CLKOS_100M_90} 10
define_multicycle_path -from {CLKOS_100M_90} -to {CLKOS3_10M} 2

#----------------------------------------------------------------------
# Section 5: CLKOS2 (20MHz) <-> CLKOP/CLKOS (100MHz) False Path
#
#   No direct data transfer between 20MHz system domain and 100MHz
#   communication domain. All CDC is through DCFIFO IP blocks.
#----------------------------------------------------------------------
define_false_path -from {CLKOS2_20M} -to {CLKOP_100M}
define_false_path -from {CLKOP_100M} -to {CLKOS2_20M}
define_false_path -from {CLKOS2_20M} -to {CLKOS_100M_90}
define_false_path -from {CLKOS_100M_90} -to {CLKOS2_20M}

#----------------------------------------------------------------------
# Section 6: CLKOP (100MHz, 0deg) <-> CLKOS (100MHz, 90deg)
#
#   SAME frequency, 90-degree phase offset. Mesochronous CDC paths
#   in cds.vhd (CDR module). Synplify analyzes these with the correct
#   2.5ns/7.5ns setup/hold windows from the clock group definition.
#   NO multicycle needed - same frequency, just phase-shifted.
#----------------------------------------------------------------------

#----------------------------------------------------------------------
# Section 7: View-level Register Preservation (syn_preserve)
#
#   All signal-level syn_preserve attributes are in the VHDL source.
#   View-level attributes below cover modules where output port
#   preservation is needed (Diamond 3.14 does not support
#   "attribute syn_preserve of PORT : signal" on output ports).
#
#   Module-specific VHDL source attributes:
#     EFUSE_CTRL.vhd    : s_PW_*_EN, s_MODE (BN132, CL190)
#     ppmc_top_S118M.vhd: s_LCW, s_LCCW (BN132)
#     ppmc_rgstr.vhd    : LIMIT_IN_A, LIMIT_MONITOR_REG_O, MPI_A (CL111, CL190)
#     gpio_ip_reg.vhd   : REG1 (MO129)
#     LEDLT_TOP.vhd     : s_LEDPTN (CL190)
#     slv_ctrl_top.vhd  : s_prpty (CL190)
#     slvadr_cnv.vhd    : s_HEX_OUT (CL279)
#     slv_rx_ctrl.vhd   : byte_cnt (CL190)
#     rx_ctl_1st.vhd    : sp_dt, sp_dt_1q, sp_dt_2q (CL177)
#----------------------------------------------------------------------

# 7A: CTRL_32CH - preserve s_LATCH register (upper bits reserved for future DAC expansion)
define_attribute {v:work.CTRL_32CH} syn_preserve {1}

# 7B: ppmc_rgstr - preserve all registers (LIMIT_IN_A, LIMIT_MONITOR_REG_O, MPI_A)
define_attribute {v:work.ppmc_rgstr} syn_preserve {1}

# 7C: ppmc_ctrl - preserve s_pls_ld / ENB_START separate control signals
define_attribute {v:work.ppmc_ctrl} syn_preserve {1}

# 7D: dec6b_5b - preserve DATAOUT register (output port, CD134 workaround)
define_attribute {v:work.dec6b_5b} syn_preserve {1}

# 7E: slv_rx_ctrl - preserve NODE register (output port, CD134 workaround)
define_attribute {v:work.slv_rx_ctrl} syn_preserve {1}

#----------------------------------------------------------------------
# Section 8: Combinational Loop Suppression (syn_loopcheck)
#
#   encoder_2bit has a registered MUX with self-feedback:
#     s_ph_a_D = (s_ph_a == ENCPHASE_A) ? s_ph_a : ...
#   This is a REGISTERED feedback through a D flip-flop, NOT a true
#   combinational loop. Suppresses BN161/BN137 for encoder instances.
#----------------------------------------------------------------------
define_attribute {v:work.encoder_2bit} syn_loopcheck {0}

#----------------------------------------------------------------------
# Section 9: IP Core Instance Preservation (syn_noprune)
#
#   Prevent removal of pll_gen internal utility instances (CL168).
#   scuba_vhi_inst (VHI) and scuba_vlo_inst (VLO) are generated by
#   Diamond IP generator and may appear unused after blackbox synthesis.
#----------------------------------------------------------------------
define_attribute {v:work.pll_gen} syn_noprune {1}
